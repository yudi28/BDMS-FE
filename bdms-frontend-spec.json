        "Unit/component tests pass.",
        "npm run build succeeds."
    ],
    "claudeInstructions": {
        "role": "Act as a Senior Vue 3 Enterprise Frontend Engineer with experience building insurance and bancassurance applications.",
        "sourceOfTruth": [
            "This JSON specification",
            "BDMS Backend OpenAPI documentation"
        ],
        "rules": [
            "Do not invent API endpoints.",
            "Use only endpoints documented in the backend OpenAPI.",
            "Do not invent response fields.",
            "Do not invent dashboard APIs.",
            "Do not put business rules in Vue that belong to the backend.",
            "Use TypeScript strictly.",
            "Use Composition API and script setup.",
            "Use Vuetify 3.",
            "Use Pinia for shared state.",
            "Use Axios through a centralized API client.",
            "Use Vue Router route guards.",
            "Use reusable components.",
            "Do not expose sensitive PII.",
            "Do not use mock data in production pages.",
            "Use loading, empty, error, and success states.",
            "Generate complete compilable code.",
            "Do not provide pseudo-code.",
            "Keep API services separate from page components.",
            "Keep page components focused on orchestration and presentation.",
            "Use typed request and response models.",
            "Do not bypass the backend authorization model.",
            "If an API capability is missing, do not fabricate it; represent the limitation in the UI."
        ],
        "implementationOrder": [
            "Initialize Vue/Vite project",
            "Install Vuetify, Pinia, Vue Router, Axios, validation and testing dependencies",
            "Create application theme and layout",
            "Create centralized Axios client",
            "Create authentication store and login",
            "Create route guards",
            "Create reusable API response and pagination types",
            "Create master-data API services",
            "Create dashboard",
            "Create agents pages",
            "Create branches pages",
            "Create banks pages",
            "Create regions pages",
            "Create areas pages",
            "Create users pages",
            "Create roles page",
            "Create audit logs page",
            "Implement RBAC UI behavior",
            "Implement tests",
            "Run npm run build and tests",
            "Generate README"
        ]
    },
