{
    "project": {
        "name": "BDMS Frontend",
        "fullName": "Banca Distributed Management System",
        "version": "1.0.0",
        "phase": 1,
        "description": "Enterprise frontend for the Banca Distributed Management System.",
        "backendBaseUrl": "http://localhost:8080",
        "apiBasePath": "/api/v1",
        "sourceOfTruth": "BDMS Backend OpenAPI 3.0.1"
    },
    "technology": {
        "framework": "Vue 3",
        "language": "TypeScript",
        "buildTool": "Vite",
        "uiFramework": "Vuetify 3",
        "stateManagement": "Pinia",
        "routing": "Vue Router",
        "httpClient": "Axios",
        "icons": "@mdi/font",
        "validation": "VeeValidate + Yup",
        "dateLibrary": "Day.js",
        "testing": [
            "Vitest",
            "Vue Test Utils"
        ],
        "linting": [
            "ESLint",
            "Prettier"
        ]
    },
    "architecture": {
        "style": "feature-oriented modular frontend",
        "principles": [
            "API-driven UI",
            "Reusable components",
            "Thin pages",
            "Business-independent presentation layer",
            "Centralized API client",
            "Centralized authentication state",
            "Role-based route and UI protection",
            "Consistent loading/error/empty states",
            "Responsive enterprise dashboard",
            "Do not duplicate backend business rules in frontend"
        ]
    },
    "folderStructure": {
        "src": [
            "assets",
            "components/common",
            "components/forms",
            "components/tables",
            "layouts",
            "pages/auth",
            "pages/dashboard",
            "pages/agents",
            "pages/branches",
            "pages/banks",
            "pages/regions",
            "pages/areas",
            "pages/users",
            "pages/roles",
            "pages/audit-logs",
            "router",
            "services",
            "stores",
            "types",
            "utils",
            "composables",
            "plugins"
        ]
    },
    "designSystem": {
        "style": "modern enterprise insurance/bancassurance application",
        "requirements": [
            "Clean professional UI",
            "Desktop-first but responsive",
            "Use Vuetify components",
            "Consistent spacing and typography",
            "Use status chips for lifecycle statuses",
            "Use confirmation dialogs for destructive or sensitive actions",
            "Never expose sensitive PII unnecessarily",
            "Mask NIK in UI",
            "Show clear success/error feedback",
            "Use skeleton/loading states",
            "Use empty states for tables",
            "Use breadcrumbs on detail pages"
        ],
        "navigation": {
            "sidebar": [
                {
                    "label": "Dashboard",
                    "route": "/dashboard",
                    "icon": "mdi-view-dashboard"
                },
                {
                    "label": "Agents",
                    "route": "/agents",
                    "icon": "mdi-account-group"
                },
                {
                    "label": "Branches",
                    "route": "/branches",
                    "icon": "mdi-office-building"
                },
                {
                    "label": "Banks",
                    "route": "/banks",
                    "icon": "mdi-bank"
                },
                {
                    "label": "Regions",
                    "route": "/regions",
                    "icon": "mdi-map"
                },
                {
                    "label": "Areas",
                    "route": "/areas",
                    "icon": "mdi-map-marker-multiple"
                },
                {
                    "label": "Users",
                    "route": "/users",
                    "icon": "mdi-account-cog"
                },
                {
                    "label": "Roles",
                    "route": "/roles",
                    "icon": "mdi-shield-account"
                },
                {
                    "label": "Audit Logs",
                    "route": "/audit-logs",
                    "icon": "mdi-history"
                }
            ]
        }
    },
    "authentication": {
        "login": {
            "endpoint": "POST /api/v1/auth/login",
            "request": {
                "username": "string",
                "password": "string"
            },
            "responseData": {
                "accessToken": "string",
                "refreshToken": "string",
                "tokenType": "string",
                "expiresIn": "number"
            }
        },
        "refresh": {
            "endpoint": "POST /api/v1/auth/refresh",
            "request": {
                "refreshToken": "string"
            }
        },
        "storage": {
            "accessToken": "sessionStorage",
            "refreshToken": "sessionStorage",
            "userProfile": "Pinia persisted state"
        },
        "axiosBehavior": [
            "Attach Authorization: Bearer <accessToken> to protected requests",
            "On HTTP 401, attempt one token refresh",
            "If refresh fails, clear authentication state and redirect to /login",
            "Never log access tokens or refresh tokens"
        ]
    },
    "apiClient": {
        "baseURL": "VITE_API_BASE_URL",
        "timeoutMs": 30000,
        "headers": {
            "Content-Type": "application/json"
        },
        "responseHandling": {
            "successEnvelope": {
                "success": true,
                "data": "object",
                "message": "string|null",
                "errorCode": "string|null",
                "timestamp": "ISO-8601",
                "traceId": "string"
            },
            "errorHandling": [
                "Display backend message when safe",
                "Display errorCode for support/debug context",
                "Display traceId on unexpected errors",
                "Handle 400 validation errors",
                "Handle 401 authentication errors",
                "Handle 403 authorization errors",
                "Handle 404 not found",
                "Handle 409 duplicate/conflict",
                "Handle 500 generic server error"
            ]
        }
    },
    "pagination": {
        "request": {
            "page": "zero-based integer",
            "size": "integer, default 20, maximum 100"
        },
        "response": {
            "content": "array",
            "page": "number",
            "size": "number",
            "totalElements": "number",
            "totalPages": "number",
            "last": "boolean"
        },
        "uiRules": [
            "Display 1-based page numbers to users",
            "Convert UI page number to zero-based API page",
            "Provide page-size selector",
            "Default page size 20",
            "Allow 20, 50, 100"
        ]
    },
    "routes": {
        "public": [
            "/login"
        ],
        "protected": [
            "/dashboard",
            "/agents",
            "/agents/:id",
            "/branches",
            "/branches/:id",
            "/banks",
            "/banks/:id",
            "/regions",
            "/regions/:id",
            "/areas",
            "/areas/:id",
            "/users",
            "/users/:id",
            "/roles",
            "/roles/:id",
            "/audit-logs"
        ]
    },
    "pages": {
        "login": {
            "route": "/login",
            "features": [
                "Username input",
                "Password input",
                "Show/hide password",
                "Login button",
                "Loading state",
                "Validation",
                "Backend error message"
            ]
        },
        "dashboard": {
            "route": "/dashboard",
            "phase": 1,
            "dataStrategy": "Use existing list APIs to obtain summary counts; do not invent dashboard APIs.",
            "widgets": [
                "Total Agents",
                "Active Agents",
                "Total Branches",
                "Active Branches",
                "Total Banks",
                "Total Users"
            ],
            "note": "If efficient aggregation is not possible from current APIs, display a simple operational dashboard and do not create fake metrics."
        },
        "agents": {
            "list": {
                "route": "/agents",
                "endpoint": "GET /api/v1/agents",
                "columns": [
                    "agentCode",
                    "nikMasked",
                    "fullName",
                    "email",
                    "phone",
                    "status",
                    "createdAt",
                    "actions"
                ],
                "features": [
                    "Pagination",
                    "Refresh",
                    "View detail",
                    "Edit",
                    "Create agent",
                    "Status chip"
                ]
            },
            "create": {
                "endpoint": "POST /api/v1/agents",
                "fields": [
                    {
                        "name": "agentCode",
                        "type": "text",
                        "required": true,
                        "maxLength": 30
                    },
                    {
                        "name": "nik",
                        "type": "text",
                        "required": true,
                        "sensitive": true
                    },
                    {
                        "name": "fullName",
                        "type": "text",
                        "required": true,
                        "maxLength": 150
                    },
                    {
                        "name": "email",
                        "type": "email",
                        "required": false,
                        "maxLength": 150
                    },
                    {
                        "name": "phone",
                        "type": "text",
                        "required": false,
                        "maxLength": 30
                    }
                ]
            },
            "edit": {
                "endpoint": "PUT /api/v1/agents/{id}",
                "fields": [
                    "fullName",
                    "email",
                    "phone",
                    "status"
                ],
                "rule": "Do not expose or edit nik from the update form because backend UpdateAgentRequest does not contain nik."
            },
            "detail": {
                "endpoint": "GET /api/v1/agents/{id}",
                "display": [
                    "agentCode",
                    "nikMasked",
                    "fullName",
                    "email",
                    "phone",
                    "status",
                    "createdAt",
                    "updatedAt"
                ]
            }
        },
        "branches": {
            "list": {
                "route": "/branches",
                "endpoint": "GET /api/v1/branches",
                "columns": [
                    "code",
                    "name",
                    "bankName",
                    "areaName",
                    "status",
                    "address",
                    "createdAt",
                    "actions"
                ]
            },
            "create": {
                "endpoint": "POST /api/v1/branches",
                "fields": [
                    "bankId",
                    "areaId",
                    "code",
                    "name",
                    "address"
                ],
                "dependentSelection": "Area selection should be filtered by selected bank where possible using available API data."
            },
            "edit": {
                "endpoint": "PUT /api/v1/branches/{id}",
                "fields": [
                    "name",
                    "status",
                    "address"
                ]
            },
            "detail": {
                "endpoint": "GET /api/v1/branches/{id}"
            }
        },
        "banks": {
            "list": {
                "route": "/banks",
                "endpoint": "GET /api/v1/banks",
                "columns": [
                    "code",
                    "name",
                    "status",
                    "createdAt",
                    "actions"
                ]
            },
            "create": {
                "endpoint": "POST /api/v1/banks",
                "fields": [
                    "code",
                    "name"
                ]
            },
            "edit": {
                "endpoint": "PUT /api/v1/banks/{id}",
                "fields": [
                    "name",
                    "status"
                ]
            }
        },
        "regions": {
            "list": {
                "route": "/regions",
                "endpoint": "GET /api/v1/regions",
                "columns": [
                    "code",
                    "name",
                    "bankName",
                    "status",
                    "createdAt",
                    "actions"
                ]
            },
            "create": {
                "endpoint": "POST /api/v1/regions",
                "fields": [
                    "bankId",
                    "code",
                    "name"
                ]
            },
            "edit": {
                "endpoint": "PUT /api/v1/regions/{id}",
                "fields": [
                    "name",
                    "status"
                ]
            }
        },
        "areas": {
            "list": {
                "route": "/areas",
                "endpoint": "GET /api/v1/areas",
                "columns": [
                    "code",
                    "name",
                    "regionName",
                    "status",
                    "createdAt",
                    "actions"
                ]
            },
            "create": {
                "endpoint": "POST /api/v1/areas",
                "fields": [
                    "regionId",
                    "code",
                    "name"
                ]
            },
            "edit": {
                "endpoint": "PUT /api/v1/areas/{id}",
                "fields": [
                    "name",
                    "status"
                ]
            }
        },
        "users": {
            "list": {
                "route": "/users",
                "endpoint": "GET /api/v1/users",
                "columns": [
                    "username",
                    "email",
                    "status",
                    "roles",
                    "createdAt",
                    "updatedAt",
                    "actions"
                ]
            },
            "create": {
                "endpoint": "POST /api/v1/users",
                "fields": [
                    "username",
                    "email",
                    "password",
                    "roleIds"
                ]
            },
            "edit": {
                "endpoint": "PUT /api/v1/users/{id}",
                "fields": [
                    "email",
                    "password",
                    "status",
                    "roleIds"
                ],
                "passwordRule": "Optional on update; never prefill an existing password."
            }
        },
        "roles": {
            "list": {
                "route": "/roles",
                "endpoint": "GET /api/v1/roles",
                "readOnly": true,
                "columns": [
                    "code",
                    "name",
                    "description",
                    "createdAt"
                ]
            },
            "detail": {
                "endpoint": "GET /api/v1/roles/{id}",
                "readOnly": true
            }
        },
        "auditLogs": {
            "list": {
                "route": "/audit-logs",
                "endpoint": "GET /api/v1/audit-logs",
                "queryParameters": [
                    "page",
                    "size",
                    "entityType"
                ],
                "columns": [
                    "createdAt",
                    "username",
                    "action",
                    "entityType",
                    "entityId",
                    "ipAddress",
                    "traceId"
                ],
                "features": [
                    "Pagination",
                    "Entity type filter",
                    "View audit detail"
                ],
                "sensitiveDataRule": "Do not render raw oldValue/newValue by default. Provide a detail dialog with formatted JSON and appropriate masking."
            }
        }
    },
    "apiServices": {
        "authService": [
            "login",
            "refresh"
        ],
        "agentService": [
            "getAgents",
            "getAgent",
            "createAgent",
            "updateAgent"
        ],
        "branchService": [
            "getBranches",
            "getBranch",
            "createBranch",
            "updateBranch"
        ],
        "bankService": [
            "getBanks",
            "getBank",
            "createBank",
            "updateBank"
        ],
        "regionService": [
            "getRegions",
            "getRegion",
            "createRegion",
            "updateRegion"
        ],
        "areaService": [
            "getAreas",
            "getArea",
            "createArea",
            "updateArea"
        ],
        "userService": [
            "getUsers",
            "getUser",
            "createUser",
            "updateUser"
        ],
        "roleService": [
            "getRoles",
            "getRole"
        ],
        "auditService": [
            "getAuditLogs"
        ]
    },
    "types": {
        "ApiResponse": {
            "success": "boolean",
            "data": "T",
            "message": "string|null",
            "errorCode": "string|null",
            "timestamp": "string",
            "traceId": "string"
        },
        "PagedResponse": {
            "content": "T[]",
            "page": "number",
            "size": "number",
            "totalElements": "number",
            "totalPages": "number",
            "last": "boolean"
        },
        "Agent": [
            "id",
            "agentCode",
            "nikMasked",
            "fullName",
            "email",
            "phone",
            "status",
            "createdAt",
            "updatedAt"
        ],
        "Branch": [
            "id",
