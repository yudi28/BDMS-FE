            "createdAt",
            "updatedAt"
        ],
        "Role": [
            "id",
            "code",
            "name",
            "description",
            "createdAt"
        ]
    },
    "stores": {
        "authStore": {
            "state": [
                "accessToken",
                "refreshToken",
                "authenticated",
                "currentUser"
            ],
            "actions": [
                "login",
                "refreshToken",
                "logout",
                "initializeAuth"
            ]
        },
        "appStore": {
            "state": [
                "sidebarOpen",
                "globalLoading",
                "notifications"
            ]
        }
    },
    "rbac": {
        "roles": [
            "ROLE_ADMIN",
            "ROLE_BRANCH_USER",
            "ROLE_MANAGER",
            "ROLE_AUDITOR"
        ],
        "uiRules": [
            "ROLE_ADMIN can access all administration screens.",
            "ROLE_AUDITOR should have read-only access to audit and permitted reference data.",
            "Do not rely only on frontend RBAC; backend remains authoritative.",
            "Hide actions the current role cannot reasonably perform.",
            "If backend returns 403, show a clear authorization message."
        ]
    },
    "statusPresentation": {
        "DRAFT": "warning",
        "PENDING_ACTIVATION": "info",
        "ACTIVE": "success",
        "SUSPENDED": "warning",
        "CLOSED": "error",
        "SUBMITTED": "info",
        "VERIFICATION": "info",
        "APPROVED": "success",
        "REJECTED": "error",
        "INACTIVE": "secondary",
        "TERMINATED": "error",
        "LOCKED": "error"
    },
    "ux": {
        "loading": [
            "Use skeleton or progress indicators during initial page loading.",
            "Disable submit button while form is submitting.",
            "Prevent duplicate form submission."
        ],
        "notifications": {
            "success": "Show snackbar after successful create/update/login.",
            "error": "Show snackbar or inline form error for expected errors.",
            "unexpected": "Show generic message plus traceId."
        },
        "forms": [
            "Client-side validation must mirror backend constraints where practical.",
            "Backend validation remains authoritative.",
            "Preserve entered values when validation fails.",
            "Show field-level validation errors where possible."
        ],
        "tables": [
            "Use Vuetify data table.",
            "Server-side pagination.",
            "Responsive horizontal scrolling on narrow screens.",
            "Show empty state when there are no records."
        ]
    },
    "security": {
        "requirements": [
            "Never display plaintext NIK.",
            "Never store passwords.",
            "Never log tokens.",
            "Never put access tokens in URL query parameters.",
            "Clear auth state on logout.",
            "Handle expired access tokens.",
            "Use route guards for protected routes.",
            "Backend remains the final authorization authority."
        ]
    },
    "environment": {
        "files": [
            ".env",
            ".env.development",
            ".env.production",
            ".env.example"
        ],
        "variables": {
            "VITE_API_BASE_URL": "http://localhost:8080"
        }
    },
    "testing": {
        "required": true,
        "unitTests": [
            "auth store",
            "API services",
            "route guards",
            "form validation",
            "status mapping"
        ],
        "componentTests": [
            "Login",
            "AgentList",
            "AgentForm",
            "BranchList",
            "BranchForm",
            "UserForm"
        ],
        "e2eCandidates": [
            "Login",
            "Create agent",
            "Update agent",
            "Create branch",
            "Update branch",
            "Create user",
            "Logout"
        ]
    },
    "nonGoalsPhase1": [
        "Agent branch transfer workflow",
        "Agent activation workflow",
        "Branch activation workflow",
        "Maker checker",
        "Notification center",
        "Bank API integration",
        "Insurance core integration",
        "SSO/OIDC",
        "Advanced reporting",
        "Real-time events"
    ],
    "definitionOfDone": [
        "Vue application starts successfully.",
        "Login works against the provided backend.",
        "JWT access token is attached to protected API requests.",
        "Refresh token flow works.",
        "Protected routes redirect unauthenticated users to login.",
        "Dashboard renders without fake backend data.",
        "All Phase 1 master-data list pages work.",
        "Create and update forms work for supported APIs.",
        "Pagination works with backend pagination.",
        "Role-aware UI is implemented.",
        "Audit log page works.",
        "PII is masked.",
        "Error handling displays backend errorCode and traceId where appropriate.",
