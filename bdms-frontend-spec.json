            "createdAt",
            "updatedAt"
        ],
        "Bank": [
            "id",
            "code",
            "name",
            "status",
            "createdAt",
            "updatedAt"
        ],
        "Region": [
            "id",
            "bankId",
            "bankName",
            "code",
            "name",
            "status",
            "createdAt",
            "updatedAt"
        ],
        "Area": [
            "id",
            "regionId",
            "regionName",
            "code",
            "name",
            "status",
            "createdAt",
            "updatedAt"
        ],
        "User": [
            "id",
            "username",
            "email",
            "status",
